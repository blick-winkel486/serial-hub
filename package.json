{
  "name": "serial-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用串口中枢：一个常驻守护进程独占串口，人类用 Web 控制台、AI 通过 MCP 或 CLI 共享同一条串口，让 AI 能自主看/发/交互式调试嵌入式开发板。与具体 AI 宿主无关（DSH / workbuddy / Cline 等）。",
  "keywords": [
    "serial",
    "uart",
    "mcp",
    "embedded",
    "console",
    "agent",
    "debug"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "serial-hub": "bin/serial-hub.js",
    "serialctl": "bin/serialctl.js",
    "serial-hub-mcp": "bin/serial-hub-mcp.js"
  },
  "scripts": {
    "daemon": "node src/daemon.js",
    "mcp": "node src/mcp-server.js",
    "cli": "node src/cli.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xterm/xterm": "^6.0.0",
    "serialport": "^13.0.0",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
